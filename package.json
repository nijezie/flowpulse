{
  "name": "flowpulse",
  "version": "1.0.0",
  "description": "Real-time stablecoin flow dashboard and betting interface",
  "keywords": [
    "stablecoin",
    "dashboard",
    "betting",
    "defi"
  ],
  "license": "MIT",
  "author": "FlowPulse Team",
  "main": "index.js",
  "scripts": {
    "build": "cd client && npm run build",
    "client": "cd client && npm start",
    "deploy": "vercel --prod",
    "deploy-preview": "vercel",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm start"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "path": "latest",
    "pg": "latest",
    "pg-native": "latest",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "latest",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "postcss": "^8.5",
    "typescript": "^5"
  }
}